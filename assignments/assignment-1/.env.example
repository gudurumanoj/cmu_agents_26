# OpenAI-compatible endpoint. Copy this file to .env and fill in your own
# base URL, key, and model. For the official OpenAI API that is
# https://api.openai.com/v1 with a model such as gpt-5.6-luna.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.6-luna

# How hard the model thinks per request. Leave empty to omit the parameter,
# which is what a model with no reasoning mode needs.
#
# OpenAI's GPT-5.6 family (luna, terra, sol) rejects /v1/chat/completions
# requests that combine function tools with any effort other than `none`, and
# every agent here calls tools, so `none` is the setting that works. Providers
# that serve open models over an OpenAI-compatible API generally accept
# `medium`.
OPENAI_REASONING_EFFORT=none

# The OpenAI SDK already retries transient failures twice. The harness raises
# this to five by default; override it here only when debugging provider issues.
OPENAI_MAX_RETRIES=5
